# 复制为 config.yaml 并填入真实配置
# 环境变量可覆盖，如 ACTIVITY_MYSQL_DSN 对应 mysql.dsn
# mysql
mysql:
  dsn: "user:password@tcp(127.0.0.1:3306)/activity_db?charset=utf8mb4&parseTime=True&loc=Local"
  max_open_conns: 20
  max_idle_conns: 5
  conn_max_lifetime_second: 3600

# redis
redis:
  addr: "127.0.0.1:6379"
  password: ""
  db: 0

rabbitmq:
  addr: "127.0.0.1:5672"
  user: "admin"
  password: ""
  publish_timeout_second: 3
  consumer_count: 5

# 定时对账：Redis -> MySQL 兜底同步
reconcile:
  interval_second: 60

# 限流：每用户/每IP每秒请求数（0或缺省用代码默认：用户20、IP10；ip_per_sec=-1关闭IP限流，压测用）
ratelimit:
  user_per_sec: 20
  ip_per_sec: 10

# jwt
jwt:
  secret: "change-me"
  expire_hour: 24

# server
server:
  port: ":8080"
