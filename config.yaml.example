# 复制为 config.yaml 并填入真实配置
# mysql
mysql:
  dsn: "user:password@tcp(127.0.0.1:3306)/activity_db?charset=utf8mb4&parseTime=True&loc=Local"
  max_open_conns: 20
  max_idle_conns: 5

# redis
redis:
  addr: "127.0.0.1:6379"
  password: ""
  db: 0

rabbitmq:
  addr: "127.0.0.1:5672"
  user: "admin"
  password: ""
  publish_timeout_second: 3
  consumer_count: 5

# 定时对账：Redis -> MySQL 兜底同步
reconcile:
  interval_second: 60

# jwt
jwt:
  secret: "change-me"
  expire_hour: 24

# server
server:
  port: ":8080"
